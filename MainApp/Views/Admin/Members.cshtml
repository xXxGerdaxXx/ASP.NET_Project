@* @model List<Infrastructure.Entities.MemberEntity> *@
@model MainApp.Models.MembersIndexViewModel


@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Team Members";
}

<section id="members">
    <header>
        <div class="page-header">
            <h2>Team Members</h2>
            <div class="button-group">
                <button id="openAddMemberModal" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add Member
                </button>
            </div>
        </div>
    </header>


        <div id="membersList">
            <partial name="~/Views/Shared/Partials/Sections/_MemberList.cshtml" model="Model" />
        </div>

</section>
<div id="editMemberModalContainer"></div>

<div id="deleteConfirmationModal" class="modal-overlay" style="display: none;">
    <div class="modal-box">
        <h3>Confirm Deletion</h3>
        <p id="deleteModalMessage">Are you sure you want to delete this member?</p>
        <div class="modal-actions">
            <button id="confirmDelete" class="btn btn-danger">Yes, Delete</button>
            <button id="cancelDelete" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>




<div id="deleteSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="deleteSuccessMessage">Member deleted successfully!</p>
    </div>
</div>
<div id="createSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="createSuccessMessage">Member created successfully!</p>
    </div>
</div>

<div id="editSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="editSuccessMessage">Member updated successfully!</p>
    </div>
</div>

<div id="deleteErrorNotification" class="notification-box" style="display: none;">
    <div class="notification-content error">
        <i class="fa-solid fa-exclamation-circle"></i>
        <p id="deleteErrorMessage">Something went wrong!</p>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/members.js")"></script>
}
