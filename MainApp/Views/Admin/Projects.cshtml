@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Projects";
}
<div class="page-header">
    <h2>Projects</h2>
    <div class="button-group">
        <button class="btn btn-primary" data-modal-target="add-project-modal">
            <i class="fa-solid fa-plus"></i> Add Project
        </button>

    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/Partials/Sections/_CreateProject.cshtml", new ProjectCreateFormModel())


<!-- ✅ Sorting Tabs -->
<div class="project-tabs">
    <button class="tab active" data-filter="all">All <span>[0]</span></button>
    <button class="tab" data-filter="started">Started <span>[0]</span></button>
    <button class="tab" data-filter="completed">Completed <span>[0]</span></button>
</div>

@* <!-- ✅ Project List (Filtered Dynamically) -->
<div id="project-list">
    @foreach (var project in Model)
    {
        <div class="project-item" data-status="@project.Status.ToLower()">
            <h4>@project.Name</h4>
            <p>@project.Description</p>
        </div>
    }
</div> *@

