@model List<Infrastructure.Entities.ClientEntity>

@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Clients";
}

<section id="clients">
    <header>
        <div class="page-header">
            <h2>Clients</h2>
            <div class="button-group">
                <button id="openAddClientModal" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add Client
                </button>
            </div>
        </div>
    </header>

    <div class="surface">
        <div id="clientsList">
            <partial name="~/Views/Shared/Partials/Sections/_ClientList.cshtml" model="Model" />
        </div>
    </div>
</section>

<div id="editClientModalContainer"></div>

<div id="deleteConfirmationModal" class="modal-overlay" style="display: none;">
    <div class="modal-box">
        <h2>Confirm Deletion</h2>
        <p>Are you sure you want to delete <strong><span id="deleteClientCount">0</span></strong> client(s)?</p>
        <div class="modal-actions">
            <button id="confirmDeleteClients" class="btn btn-danger">Yes, Delete</button>
            <button id="cancelDeleteClients" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>

<div id="deleteSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="deleteSuccessMessage">Client deleted successfully!</p>
    </div>
</div>
 <div id="createSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="createSuccessMessage">Client created successfully!</p>
    </div>
</div> 

<div id="editSuccessNotification" class="notification-box" style="display: none;">
    <div class="notification-content success">
        <i class="fa-solid fa-check-circle"></i>
        <p id="editSuccessMessage">Client updated successfully!</p>
    </div>
</div>

<div id="deleteErrorNotification" class="notification-box" style="display: none;">
    <div class="notification-content error">
        <i class="fa-solid fa-exclamation-circle"></i>
        <p id="deleteErrorMessage">Something went wrong!</p>
    </div>
</div>

