@model List<Infrastructure.Entities.ClientEntity>

@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Clients";
}

<!-- ✅ Partial for Edit Client -->
<partial name="Partials/Sections/_EditClient" />

<!-- ✅ Partial for Create Client Modal (Ensures modal styling is used) -->
<partial name="Partials/Sections/_CreateClient" />

<section id="clients">
    <header>
        <div class="page-header">
            <h2>Clients</h2>
            <div class="button-group">
                <!-- ✅ Button to Open Modal -->
                <button id="openAddClientModal" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add Client
                </button>
            </div>
        </div>
    </header>

    <div class="surface">
        <!-- ✅ Clients List Partial -->
        <div id="clientsList">
            <partial name="~/Views/Shared/Partials/Sections/_ClientList.cshtml" model="Model" />
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadClients(); // ✅ Load clients list on page load

        function loadClients() {
            fetch('/admin/clients/list')
                .then(response => response.text())
                .then(html => {
                    document.getElementById("clientsList").innerHTML = html;
                })
                .catch(error => console.error("Error loading clients:", error));
        }

        // ✅ Open "Create Client" modal
        document.getElementById("openAddClientModal").addEventListener("click", function () {
            const modal = document.getElementById("add-client-modal");
            if (modal) {
                modal.classList.add("active");
                modal.style.display = "flex"; // ✅ Ensure modal appears
            } else {
                console.error("ERROR: Modal not found!");
            }
        });

        // ✅ Close "Create Client" modal
        document.getElementById("closeAddClientModal").addEventListener("click", function () {
            const modal = document.getElementById("add-client-modal");
            if (modal) {
                modal.classList.remove("active");
                modal.style.display = "none";
                document.getElementById("createClientForm").reset(); // ✅ Reset form
            }
        });

        // ✅ Handle Create Client form submission
        document.getElementById("createClientForm").addEventListener("submit", function (event) {
            event.preventDefault();
            const formData = new FormData(this);

            fetch('/admin/clients/create', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const modal = document.getElementById("add-client-modal");
                    if (modal) {
                        modal.classList.remove("active");
                        modal.style.display = "none";
                        document.getElementById("createClientForm").reset();
                    }
                    loadClients(); // ✅ Refresh clients list after adding
                } else {
                    alert("Error: " + data.message);
                }
            })
            .catch(error => console.error("Error creating client:", error));
        });
    });
</script>
