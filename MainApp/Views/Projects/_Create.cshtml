@model ProjectCreateFormModel

<div id="add-project-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>New Project</h2>
            <button data-close-modal class="btn-close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <div class="image-preview-container">
            <div class="circle circle-gray">
                <i class="fa-solid fa-camera"></i>
            </div>
        </div>

        <form id="projectForm" action="/projects/create" method="post">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name">
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClientId"></label>
                <div class="client-search-container">
                    <div class="search-input-wrapper">
                        <input type="text" id="clientSearch" placeholder="Search Clients..." autocomplete="off">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>


                <!-- Hidden textarea to store formatted content -->
                <textarea asp-for="Description" id="description" name="Description" hidden></textarea>

                <!-- Quill Editor -->
                <div id="quill-editor"></div>
                <span asp-validation-for="Description"></span>
            </div>



            <div class="date-fields">
                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date">
                    <span asp-validation-for="StartDate"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date">
                    <span asp-validation-for="EndDate"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="TeamMemberSearch "></label>
            <div class="team-member-search-container">
                <div class="search-input-wrapper">
                    <input asp-for="TeamMemberSearch" id="teamMemberSearch" placeholder="Search Team Members...">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                </div>
                </div>

                <div id="teamMemberList" class="team-member-list">
                    <!-- Populate dynamically -->
                    <ul>
                        <li data-id="1">John Doe</li>
                        <li data-id="2">Jane Smith</li>
                        <li data-id="3">Alice Johnson</li>
                        <li data-id="4">Bob Williams</li>
                    </ul>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="Budget"></label>
                <input asp-for="Budget" type="number" step="0.01">
                <span asp-validation-for="Budget"></span>
            </div>


            <footer>
                <button type="submit" class="btn btn-blue-submit">Create</button>
            </footer>
        </form>
    </div>
</div>
