@model List<Infrastructure.Entities.ProjectEntity>

@{
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    ViewData["Title"] = "Projects";
}

<section id="projects">
    <header>
        <div class="page-header">
            <h2>Right Projects</h2>
            <div class="button-group">
                <button id="openAddProjectModal" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add Project
                </button>
            </div>
        </div>
    </header>

    <!-- ✅ Sorting Tabs -->
    <div class="project-tabs">
        <button class="tab active" data-filter="all">All <span>[0]</span></button>
        <button class="tab" data-filter="started">Started <span>[0]</span></button>
        <button class="tab" data-filter="completed">Completed <span>[0]</span></button>
    </div>
    <div id="projectsList">
        <partial name="~/Views/Shared/Partials/Sections/_ProjectList.cshtml" model="Model" />
    </div>

</section>
<div id="editProjectModalContainer"></div>







