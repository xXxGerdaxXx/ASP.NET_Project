@model FileUploadViewModel

@{
    ViewBag.Title = "File Upload";
}
<div class="surface">
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
        <a asp-action="Upload" class="btn btn-blue">Refresh</a>
    }
    else
    {
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <div class="image-preview-container">
                <div id="circle-container" class="circle circle-gray">
                    <i class="fa-duotone fa-solid fa-camera"></i>
                </div>
                <img id="image-preview" src="#" alt="Image Preview" class="d-none">
            </div>

            <div class="form-group">
                <label asp-for="File"></label>
                <input asp-for="File" accept="image/*" class="form-control">
                <span asp-validation-for="File"></span>
            </div>

            <button type="submit" class="btn btn-blue">Upload file</button>
        </form>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll('.image-previewer').forEach(previewer => {
            const input = previewer.querySelector('input[type="file"]');
            const img = previewer.querySelector('.image-preview');

            if (!input || !img) return;

            input.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        img.src = event.target.result;
                        img.classList.remove("d-none");
                        previewer.classList.add("selected"); 
                    };
                    reader.readAsDataURL(file);
                } else {
                    img.src = "";
                    img.classList.add("d-none");
                    previewer.classList.remove("selected"); 
                }
            });

            previewer.addEventListener("click", () => input.click());
        });
    });
 
</script>
