@{
    ViewData["Title"] = "Welcome";
}

<div class="form-container">
    <div class="form-box">
        <h2>Welcome</h2>
        <p>Please sign up or log in to continue</p>

        <div class="button-group">
            <a class="btn btn-primary full-width" asp-controller="Account" asp-action="Register">Sign Up</a>
            <a class="btn btn-outline full-width" asp-controller="Account" asp-action="Login">Log In</a>
        </div>
    </div>
</div>
