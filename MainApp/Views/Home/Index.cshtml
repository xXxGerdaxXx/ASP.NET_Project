@{
    ViewData["Title"] = "Welcome";
}

<div class="form-wrapper">
    <div class="form-container">
        <div class="form-box">
            <h2>Welcome</h2>
            <p>Please sign up or log in to continue</p>

            <div class="button-group">
                <a class="btn-primary" asp-controller="Account" asp-action="Register">Sign Up</a>
                <a class="btn-primary" asp-controller="Account" asp-action="Login">User Log In</a>
                <a class="btn-primary" asp-controller="Account" asp-action="Login">Admin Log In</a>
            </div>
        </div>
    </div>
</div>
