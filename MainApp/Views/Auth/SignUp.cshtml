@model SignUpFormModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="card bg-white">
    <div class="card-body">
<form method="post" asp-controller="Auth" asp-action="SignUp" novalidate>
<div class="mb-3">
    <label asp-for="FirstName" class="form-label">First Name</label>
    <input asp-for="FirstName" class="form-control">
    <span asp-validation-for="FirstName"></span>
</div>
<div class="mb-3">
    <label asp-for="LastName" class="form-label">Last Name</label>
    <input asp-for="LastName" class="form-control">
    <span asp-validation-for="LastName"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label">Email Address</label>
    <input asp-for="Email" class="form-control">
    <span asp-validation-for="Email"></span>
</div>
<div class="mb-3">
    <label asp-for="Password" class="form-label">Password</label>
    <input asp-for="Password" class="form-control" value="@Model?.Password">
    <span asp-validation-for="Password"></span>
</div>
<div class="mb-5">
    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
    <input asp-for="ConfirmPassword" class="form-control" value="@Model?.ConfirmPassword">
    <span asp-validation-for="ConfirmPassword"></span>
</div>

            <div class="form-check mb-3">
                <input asp-for="AcceptTerms" class="form-check-input" type="checkbox" />
                <label asp-for="AcceptTerms" class="form-check-label">
                    I agree to the <a href="/terms">terms and conditions</a>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sign Up</button>
</form>
    </div>
</div>
