<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alpha Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700&display=swap" rel="stylesheet">
@*     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="http://kit.fontawesome.com/a576612222.css" crossorigin="anonymous" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <!-- Tom Select CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet" />

</head>
<body>

    <div class="portal">
        <div class="logotype">
            @await Html.PartialAsync("Partials/Components/_AlphaLogotype")
        </div>
        <div class="side">
            @await Html.PartialAsync("Partials/Components/_NavLinks")
        </div>
        <div class="top">
            @await Html.PartialAsync("Partials/Components/_SearchBar")
            @await Html.PartialAsync("Partials/Components/_UserMenu")
        </div>
        <div id="createSuccessNotification" class="global-notification success" style="display: none;">
            <p></p>
        </div>
        <div id="deleteErrorNotification" class="global-notification error" style="display: none;">
            <p></p>
        </div>

        <div class="main">
            @RenderBody() 
        </div>
        <div id="modalContainer"></div>
    </div>

 <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> 
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/clients.js"></script>
    <script src="~/js/members.js"></script>
    <script src="~/js/projects.js"></script>
    <!-- Tom Select JS -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
   

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
