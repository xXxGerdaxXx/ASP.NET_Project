@model MainApp.Models.UserMenuViewModel

<div class="user-menu">
    @await Html.PartialAsync("_NotificationDropdown", Model.Notifications)

    <div class="profile-dropdown">
        <button class="icon-button" id="settingsButton">
            <i class="fa-solid fa-gear"></i>
        </button>

        <div class="dropdown-content" id="userDropdown">
            <div class="dropdown-item dropdown-header">
                <img src="@Model.AvatarPath" class="dropdown-avatar" alt="User Avatar" />
                <a asp-controller="Auth" asp-action="EditProfile" class="dropdown-user-name">
                    @Model.FullName
                </a>
            </div>

            <div class="dropdown-item toggle-theme" id="themeToggle">
                <div class="label-group">
                    <i class="fa-solid fa-gear"></i>
                    <span>Dark Mode</span>
                </div>
                <div class="toggle-switch">
                    <div class="toggle-slider"></div>
                </div>
            </div>

            <form method="post" asp-controller="Auth" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item logout-button">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>
    <div class="vertical-divider"></div>
    <div class="avatar-display">
        <img src="@Model.AvatarPath" alt="User Avatar" />
    </div>
</div>
