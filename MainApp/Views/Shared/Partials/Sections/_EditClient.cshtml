@model ClientEditFormModel

<div id="edit-client-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>Edit Client</h2>
            <button id="closeEditClientModal" class="btn-close"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <form id="editClientForm" asp-action="EditClient" novalidate asp-controller="Clients" method="post" enctype="multipart/form-data">
        

            <input asp-for="Id" readonly type="hidden" /> <!-- ✅ Ensure the ID is passed -->

            <div class="image-previewer circle">
                <img src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/Avatar.svg")"
                     class="image-preview" />
                <input asp-for="File" type="file" accept="image/*" class="hide" />
            </div>

            <div class="form-group">
                <label asp-for="ClientName"></label>
                <div class="field-group">
                    <input asp-for="ClientName">
                    <span asp-validation-for="ClientName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ContactPerson"></label>
                <div class="field-group">
                    <input asp-for="ContactPerson">
                    <span asp-validation-for="ContactPerson"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <div class="field-group">
                    <input asp-for="Email">
                    <span asp-validation-for="Email"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <div class="field-group">
                    <input asp-for="PhoneNumber">
                    <span asp-validation-for="PhoneNumber"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Address"></label>
                <div class="field-group">
                    <input asp-for="Address">
                    <span asp-validation-for="Address"></span>
                </div>
            </div>

            <footer class="modal-footer">
                <button type="button" class="btn-blue-submit">Update Client</button>
            </footer>
        </form>
    </div>
</div>
