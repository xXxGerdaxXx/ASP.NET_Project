@model List<Infrastructure.Entities.MemberEntity>

@if (Model == null)
{
    <p class="error-message">Error: Unable to load members.</p>
}
else if (!Model.Any())
{
    <p class="info-message">No members available at the moment.</p>
}
else
{
    <section id="membersList" class="members-grid">
        @foreach (var member in Model)
        {
            <div class="member-card">
                <!-- More Options Button -->
                <div class="member-actions">
                    <button class="edit-member-btn" data-member-id="@member.Id" aria-label="Edit member">
                        <i class="fa-solid fa-ellipsis"></i>
                    </button>
                </div>

                <!-- Profile Avatar -->
                <div class="member-avatar">
                    <img src="@(!string.IsNullOrEmpty(member.AvatarUrl) ? member.AvatarUrl : "/images/Avatar.svg")"
                         alt="Profile picture of @member.FirstName @member.LastName"
                         class="avatar-img" />
                </div>

                <!-- Member Details -->
                <h3 class="member-name">@member.FirstName @member.LastName</h3>
                <div class="member-role">@member.JobTitle</div>
                <div class="member-email">
                    <a href="mailto:@member.Email">@member.Email</a>
                </div>
                <div class="member-address">@member.Address</div>
                <div class="member-phone">
                    <a href="tel:@member.PhoneNumber">@member.PhoneNumber</a>
                </div>

                <!-- Contact Button -->
                <button class="message-btn" aria-label="Send message to @member.FirstName @member.LastName">
                    Message
                </button>
            </div>
        }
    </section>
}
