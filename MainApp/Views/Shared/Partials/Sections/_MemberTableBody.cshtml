@model List<Infrastructure.Entities.MemberEntity>

@if (Model == null)
{
    <p>Model is NULL!</p>
}
else if (!Model.Any())
{
    <p>No members available (empty list).</p>
}
else
{
    <div class="members-grid">
        @foreach (var member in Model)
        {
            <div class="member-card">
                <div class="member-actions">
                    <i class="fa-solid fa-ellipsis" data-modal="true" data-target="#edit-member-modal"></i>
                </div>
@* 
                <div class="member-avatar">
                    <img src="@(!string.IsNullOrEmpty(member.ProfileImage) ? member.ProfileImage : "/images/Avatar.svg")"
                         alt="@member.FirstName @member.LastName" />
                </div> *@

                <div class="member-role">@member.JobTitle</div>
                <div class="member-name">@member.FirstName @member.LastName</div>
                <div class="member-email">@member.Email</div>
                <div class="member-address">@member.Address</div>
                <div class="member-phone">@member.PhoneNumber</div>

                <button class="message-btn">Message</button>
            </div>
        }
    </div>
}
