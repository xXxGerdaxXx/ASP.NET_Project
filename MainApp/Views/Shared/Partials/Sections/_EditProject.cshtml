@model ProjectEditFormModel

<div id="edit-project-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>Edit Project</h2>
            <button id="closeEditProjectModal" class="btn-close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>
        @{
            var jsonMembers = ViewBag.PreselectedTeamMembersJson;
        }

        <form id="editProjectForm"
              data-preselected-members='@ViewBag.PreselectedTeamMembersJson'
              asp-action="EditProject"
              asp-controller="Projects"
              method="post"
              enctype="multipart/form-data"
              novalidate>
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="image-previewer square">
                <img src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/Avatar.svg")" class="image-preview" />
                <input asp-for="ProjectImage" accept="image/*" class="hide" />
            </div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <div class="field-group">
                    <input asp-for="Name" class="form-control"/>
                    <span asp-validation-for="Name"></span>
                </div>
            </div>

            <div class="select-wrapper">
                <label asp-for="ClientId"></label>
                <select asp-for="ClientId" asp-items="Model.ClientList" class="form-control">
                    <option value="">-- Select a client --</option>
                </select>
                <i class="fa-solid fa-chevron-down select-icon"></i>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <input type="hidden" asp-for="Description" id="Description"/>
                <div class="quill-wrapper">
                    <div id="quill-editor"></div>
                    <div id="quill-toolbar"></div>
                </div>

                <span asp-validation-for="Description"></span>
            </div>

            <div class="sidebyside-fields">
                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-control"/>
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Members</label>
                <div id="edit-tags" class="form-input form-tag-select">
                    <input type="text" id="edit-tag-search" class="form-tag-input" placeholder="Add more member(s)..." />
                    <label for="edit-tag-search"></label>
                    <div id="edit-tag-search-results" class="search-results"></div>

                    <input type="hidden" name="SelectedTeamMemberIds" id="SelectedTeamMemberIds" />
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                </div>
            </div>

            <div class="select-wrapper">
                <label asp-for="StatusId"></label>
                <select asp-for="StatusId" asp-items="Model.StatusList" class="form-control">
                    <option value="">-- Select status --</option>
                </select>
                <i class="fa-solid fa-chevron-down select-icon"></i>
                <span asp-validation-for="StatusId"></span>
            </div>

            <div class="form-group">
                <label asp-for="Budget"></label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-dollar-sign"></i>
                    <input asp-for="Budget" type="number" class="form-control" placeholder="Enter amount" />
                </div>
                <span asp-validation-for="Budget"></span>
            </div>

            <footer class="modal-footer">
                <button type="submit" class="btn-blue-submit">Update Project</button>
            </footer>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
