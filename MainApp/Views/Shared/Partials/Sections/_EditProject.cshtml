@model ProjectEditFormModel

<div id="edit-project-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>Edit Project</h2>
            <button id="closeEditProjectModal" class="btn-close"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <form id="editProjectForm" asp-action="EditProject" asp-controller="Projects" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="Id" />

        
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="image-previewer square">
                <img src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/Avatar.svg")"
                     class="image-preview" />
                <input asp-for="ProjectImage" accept="image/*" class="hide" />
            </div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClientId"></label>
                <select asp-for="ClientId" asp-items="Model.ClientList" class="form-control"></select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control textarea"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="sidebyside-fields">
                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            @*             <div class="form-group team-member-search-container">
                <label asp-for="TeamMemberSearch"></label>
                <input asp-for="TeamMemberSearch" placeholder="Search Team Members..." class="form-control" />
                <span asp-validation-for="TeamMemberSearch" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="StatusId"></label>
                <select asp-for="StatusId" asp-items="Model.StatusList" class="form-control">
                    <option value="">-- Select status --</option>
                </select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Budget"></label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-dollar-sign"></i>
                    <input asp-for="Budget" type="number" class="form-control" placeholder="Enter amount" />
                </div>
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>

            <footer class="modal-footer">
                <button type="submit" class="btn-blue-submit">Update Project</button>
                <button type="button" id="deleteProjectBtn" class="btn btn-red-delete">Delete Project</button>
            </footer>
        </form>
    </div>
</div>
