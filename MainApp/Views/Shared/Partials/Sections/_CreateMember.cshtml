@using Infrastructure.Helpers
@using Infrastructure.Enums

@model MemberCreateForm

<div id="add-member-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>New Member</h2>
            <button id="closeAddMemberModal" class="btn-close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <form novalidate method="post" id="createMemberForm" asp-controller="Members" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="image-previewer circle">
                <img src="" alt="Image Preview" class="image-preview d-none" />
                <input asp-for="File" type="file" accept="image/*" class="hide" />
            </div>


            <div class="sidebyside-fields">
                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <div class="field-group">
                        <input asp-for="FirstName">
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <div class="field-group">
                        <input asp-for="LastName">
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <div class="field-group">
                    <input asp-for="Email">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <div class="field-group">
                    <input asp-for="PhoneNumber">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <!-- Job Title -->
            <div class="select-wrapper">
                <label asp-for="JobTitle"></label>
                    <select asp-for="JobTitle" asp-items="@EnumExtensions.GetEnumSelectListWithDescription<JobTitle>()" class="form-control">
                        <option value="">Your Job Title</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-icon"></i>
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>



            <!-- Address -->
            <div class="form-group">
                <label asp-for="Address"></label>
                <div class="field-group">
                    <input asp-for="Address">
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <!-- Date of Birth -->
            <div class="form-group">
                <label>Date of Birth</label>
                <div class="date-inputs">

                    <div class="select-wrapper">
                        <select asp-for="BirthDay" class="form-control">
                            <option value="">Day</option>
                            @for (int i = 1; i <= 31; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                        <span asp-validation-for="BirthDay" class="text-danger"></span>
                    </div>

                    <div class="select-wrapper">
                        <select asp-for="BirthMonth" class="form-control">
                            <option value="">Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                        <span asp-validation-for="BirthMonth" class="text-danger"></span>
                    </div>

                    <div class="select-wrapper">
                        <select asp-for="BirthYear" class="form-control">
                            <option value="">Year</option>
                            @for (int i = DateTime.Now.Year; i >= 1900; i--)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                        <span asp-validation-for="BirthYear" class="text-danger"></span>
                    </div>

                </div>
            </div>


            <footer class="modal-footer">
                <button type="submit" class="btn-blue-submit">Add Member</button>
            </footer>
        </form>

    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
