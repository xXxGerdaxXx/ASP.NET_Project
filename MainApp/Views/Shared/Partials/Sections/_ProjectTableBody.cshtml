@model List<ProjectViewModel>

@if (Model == null)
{
    <p>Model is NULL!</p>
}
else if (!Model.Any())
{
    <p>No projects available (empty list).</p>
}
else
{
    <section id="projectsList" class="project-grid">
        @foreach (var project in Model)
        {
            <partial name="Partials/Sections/_ProjectCard" model="project" />

        }
    </section>
}



