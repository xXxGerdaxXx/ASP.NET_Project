@model ProjectViewModel

@{
    var validEndDate = Model.EndDate != default(DateTime);
    var daysLeft = validEndDate ? (Model.EndDate - DateTime.Now).Days : 0;
    var isOverdue = validEndDate && daysLeft < 0;
}

<div class="project-card">
    <div class="card-header">
        <div class="card-logo">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; border-radius: inherit;" />
            }
            else
            {
                @Model.Name.Substring(0, 1).ToUpper()
            }
        </div>
        <div>
            <div class="card-title">@Model.Name</div>
            <div class="card-desc">@Model.Company</div>
        </div>

        <div class="project-actions">
            <button class="icon-button" onclick="toggleDropdown(this)">
                <i class="fa-solid fa-ellipsis"></i>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item" data-project-id="@Model.Id" onclick="loadEditProjectModal(@Model.Id)">
                    <i class="fa-solid fa-pen-to-square"></i> Edit Project
                </button>

                <form method="post" asp-action="AddMember" asp-controller="Projects" asp-route-projectId="@Model.Id">
                    <button type="submit" class="dropdown-item">
                        <i class="fa-solid fa-user-plus"></i> Add Member
                    </button>
                </form>

                <form method="post" asp-action="DeleteProject" asp-controller="Projects" asp-route-projectId="@Model.Id" onsubmit="return confirm('Are you sure you want to delete this project?')">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="fa-solid fa-trash"></i> Delete Project
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="card-desc">@Model.Description</div>

    <div class="card-footer">
        @if (!validEndDate)
        {
            <span class="time-label">No deadline</span>
        }
        else if (isOverdue)
        {
            <span class="time-label urgent">Overdue by @Math.Abs(daysLeft) day(s)</span>
        }
        else
        {
            <span class="time-label">@daysLeft day(s) left</span>
        }

        <div class="avatar-group">
            @foreach (var member in Model.TeamMembers)
            {
                <img src="@member.AvatarUrl" alt="@member.Name" title="@member.Name" />
            }
        </div>
    </div>
</div>


<script>
    // Toggle the dropdown menu for the project actions
    function toggleDropdown(button) {
        const menu = button.nextElementSibling;

        // Close other open dropdowns
        document.querySelectorAll('.dropdown-menu').forEach(m => {
            if (m !== menu) m.style.display = 'none';
        });

        // Toggle the clicked menu
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    // Close the dropdown if the user clicks outside
    document.addEventListener("click", function (e) {
        if (!e.target.closest('.project-actions')) {
            document.querySelectorAll('.dropdown-menu').forEach(m => m.style.display = 'none');
        }
    });

    // Load the modal to edit the project
    function loadEditProjectModal(projectId) {
        fetch(`/projects/edit/${projectId}`)
            .then(response => response.text())
            .then(html => {
                // Remove any existing modal to prevent duplicates
                removeExistingModal("edit-project-modal");

                const modalContainer = document.createElement("div");
                modalContainer.innerHTML = html;
                document.body.appendChild(modalContainer);

                const modal = document.getElementById("edit-project-modal");
                if (modal) {
                    modal.classList.add("active");
                    modal.style.display = "flex";

                    modal.querySelector("#closeEditProjectModal")?.addEventListener("click", function () {
                        modal.remove();
                    });

                    setupFileUploadPreview("editProjectForm");
                    setupEditFormSubmission(projectId);

                    const deleteButton = modal.querySelector("#deleteProjectBtn");
                    if (deleteButton) {
                        deleteButton.addEventListener("click", function () {
                            deleteProject(projectId);
                        });
                    }
                }
            })
            .catch(error => console.error("Error loading edit project modal.", error));
    }

    // Utility function to remove any existing modal before appending a new one
    function removeExistingModal(modalId) {
        const existingModal = document.getElementById(modalId);
        if (existingModal) existingModal.remove();
    }

    // Handle form submission for editing the project (to be implemented in your modal)
    function setupEditFormSubmission(projectId) {
        const editForm = document.getElementById("editProjectForm");
        if (!editForm) {
            console.error("Edit form not found!");
            return;
        }

        editForm.addEventListener("submit", function (event) {
            event.preventDefault();
            const formData = new FormData(editForm);

            fetch(`/projects/editproject`, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessMessage("Project updated successfully!");
                    document.getElementById("edit-project-modal").remove();
                    loadProjects();
                } else {
                    displayServerErrors(data.errors);
                }
            })
            .catch(error => showErrorMessage("Error updating project."));
        });
    }

    // Utility functions to handle success/error messages (you can modify these)
    function showSuccessMessage(message) {
        alert(message); // Replace with your own notification system
    }

    function showErrorMessage(message) {
        alert(message); // Replace with your own notification system
    }

    function displayServerErrors(errors) {
        // Handle displaying server-side validation errors (if any)
        console.log(errors);
    }
</script>
