@model ProjectViewModel

@{
    var daysLeft = (Model.EndDate - DateTime.Now).Days;
    var isOverdue = daysLeft < 0;
}

<div class="project-card">
    <div class="project-actions">
        <i class="fa-solid fa-ellipsis edit-project-btn"
           data-project-id="@Model.Id"
           data-modal="true"
           data-target="#edit-project-modal"></i>
    </div>

    <div class="project-header">
        <div class="project-avatar">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img class="project-image" src="@Model.AvatarUrl" alt="@Model.Name" />
            }
            else
            {
                <div class="avatar-placeholder">@Model.Name.Substring(0, 1).ToUpper()</div>
            }
        </div>
        <div class="project-info">
            <div class="project-title">@Model.Name</div>
            <div class="project-client">Client: @Model.Company</div>
        </div>
    </div>

    <div class="project-description">@Model.Description</div>
    <div class="project-status">Status: @Model.Status</div>

    <p class="time-left">
        @if (isOverdue)
        {
            <span class="overdue text-danger fw-bold">Overdue by @Math.Abs(daysLeft) day(s)</span>
        }
        else
        {
            <span class="on-time text-success">@daysLeft day(s) left</span>
        }
    </p>

    <div class="avatar-group">
        @foreach (var member in Model.TeamMembers)
        {
            <img src="@member.AvatarUrl" alt="@member.Name" title="@member.Name" />
        }
    </div>
</div>
