<div class="member-card">
    <div class="member-actions">
        <i class="fa-solid fa-ellipsis" data-modal="true" data-target="#edit-member-modal"></i>
    </div>

    <div class="member-avatar">
        <img src="@(!string.IsNullOrEmpty(Model.ProfileImage) ? Model.ProfileImage : "/images/Avatar.svg")" alt="@Model.FirstName @Model.LastName" />
    </div>

    <div class="member-role">@Model.JobTitle</div>
    <div class="member-name">@Model.FirstName @Model.LastName</div>
    <div class="member-email">@Model.Email</div>
    <div class="member-address">@Model.Address</div>
    <div class="member-phone">@Model.PhoneNumber</div>

    <button class="message-btn">Message</button>
</div>
