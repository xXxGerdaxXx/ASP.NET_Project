@model EditProfileViewModel

<div id="edit-profile-modal" class="modal-overlay">
    <div class="surface-modal">

        <header>
            <h2>Edit Profile</h2>
            <button id="closeEditProfileModal" class="btn-close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <form id="editProfileForm" method="post" asp-controller="Auth" asp-action="EditProfile" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="image-previewer square">
                <img src="@(!string.IsNullOrEmpty(Model.CurrentAvatarUrl) ? Model.CurrentAvatarUrl : "/uploads/projects.svg")"
                     class="image-preview" />

                <input asp-for="Avatar" type="file" accept="image/*" class="hide" />
            </div>

            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <footer>
                <button type="submit" class="btn-blue-submit">Save Changes</button>
            </footer>
        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/editProfile.js"></script>
}
