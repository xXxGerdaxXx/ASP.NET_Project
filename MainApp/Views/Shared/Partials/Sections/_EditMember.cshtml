@using Infrastructure.Enums
@using Infrastructure.Helpers
@model MemberEditFormModel

<div id="edit-member-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>Edit Member</h2>
            <button id="closeEditMemberModal" class="btn-close"><i class="fa-solid fa-xmark"></i></button>
        </header>
        <form id="editMemberForm" asp-action="EditMember" method="post" enctype="multipart/form-data" novalidate asp-controller="Admin">
                <input asp-for="Id" readonly type="hidden" />

            <div class="image-previewer circle">
                <img src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/Avatar.svg")"
                     class="image-preview" />
                <input asp-for="File" accept="image/*" class="hide" />
            </div>

            <div class="sidebyside-fields">
                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber">
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="select-wrapper">
                <label asp-for="JobTitle"></label>
                <select asp-for="JobTitle" asp-items="EnumExtensions.GetEnumSelectListWithDescription<JobTitle>()" class="form-control"></select>
                <i class="fa-solid fa-chevron-down select-icon"></i>
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Address"></label>
                <input asp-for="Address">
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Date of Birth</label>
                <div class="date-inputs">

                    <div class="select-wrapper">
                        <select class="form-control" name="BirthDay" id="BirthDay">
                            <option value="" disabled>Day</option>
                            @for (int i = 1; i <= 31; i++)
                            {
                                <option value="@i" selected="@(Model.BirthDay == i ? "selected" : null)">@i</option>
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                    </div>

                    <div class="select-wrapper">
                        <select class="form-control" name="BirthMonth" id="BirthMonth">
                            <option value="" disabled>Month</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                var monthName = new DateTime(2000, i, 1).ToString("MMMM");
                                <option value="@i" selected="@(Model.BirthMonth == i ? "selected" : null)">@monthName</option>
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                    </div>

                    <div class="select-wrapper">
                        <select class="form-control" name="BirthYear" id="BirthYear">
                            <option value="" disabled>Year</option>
                            @for (int i = DateTime.Now.Year; i >= 1900; i--)
                            {
                                <option value="@i" selected="@(Model.BirthYear == i ? "selected" : null)">@i</option>
                            }
                        </select>
                        <i class="fa-solid fa-chevron-down select-icon"></i>
                    </div>

                </div>
            </div>

            <footer class="modal-footer">
                <button type="submit" class="btn-blue-submit">Update Member</button>
                <button type="button" id="deleteMemberBtn" class="btn btn-red-delete">Delete Member</button>
            </footer>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
