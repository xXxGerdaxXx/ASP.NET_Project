@model ClientCreateFormModel

<div id="add-client-modal" class="modal-overlay">
    <div class="surface-modal">
        <header>
            <h2>New Client</h2>
            <button id="closeAddClientModal" class="btn-close"><i class="fa-solid fa-xmark"></i></button>
        </header>
@*         <div class="image-preview-container">
            <div class="circle circle-gray">
                <i class="fa-solid fa-camera"></i>
            </div>
        </div> *@
        <form asp-action="CreateClient" method="post" enctype="multipart/form-data" novalidate asp-controller="Admin">
            <div class="image-previewer circle">
                <img src="" class="image-previewer" />
                    <input asp-for="File" accept="image/*" class="hide" />
                </div>


            <div class="form-group">
                <label asp-for="ClientName"></label>
                <div class="field-group">
                    <input asp-for="ClientName">
                    <span asp-validation-for="ClientName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ContactPerson"></label>
                <div class="field-group">
                    <input asp-for="ContactPerson">
                    <span asp-validation-for="ContactPerson"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <div class="field-group">
                    <input asp-for="Email">
                    <span asp-validation-for="Email"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Phone"></label>
                <div class="field-group">
                    <input asp-for="Phone">
                    <span asp-validation-for="Phone"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Address"></label>
                <div class="field-group">
                    <input asp-for="Address">
                    <span asp-validation-for="Address"></span>
                </div>
            </div>

            <footer class="modal-footer">
                <button type="submit" class="btn-blue-submit">Create</button>
            </footer>
        </form>
    </div>
</div>
