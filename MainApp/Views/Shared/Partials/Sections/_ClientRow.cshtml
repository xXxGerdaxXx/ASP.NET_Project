@model Infrastructure.Entities.ClientEntity

<tr>
    <td class="client-check"><input type="checkbox" /></td>
    <td class="client-info">
        <img class="client-image" src="~/images/Avatar.svg" alt="Avatar of @Model.ClientName" />
        <div class="client-name">@Model.ClientName</div>
        <div class="client-email">@Model.Email</div>
    </td>
    <td class="client-address">@Model.Address</td>
    <td class="client-phone">@Model.PhoneNumber</td>
    <td class="client-date">@Model.CreatedAt.ToString("yyyy-MM-dd")</td>
    <td class="client-actions">
        <i class="fa-solid fa-ellipsis" data-modal="true" data-target="#edit-client-modal"></i>

    </td>
</tr>
